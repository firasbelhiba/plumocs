// Plumo CS — database schema (PostgreSQL 16).
// Enums are Postgres enum types; timestamps are timestamptz; ids are UUID.
// SLA targets are integers (minutes).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// Two URLs on purpose (see prisma/sql/roles.sql):
//   url       → plumo_app, the runtime. Owns nothing, NOBYPASSRLS, DML only.
//   directUrl → plumo_migrator, the schema owner. Prisma Migrate uses this one.
// Splitting them is what makes row-level security capable of enforcing anything:
// a superuser or table owner is exempt from policies, so if the runtime kept
// connecting as the owner every policy would install cleanly and do nothing.
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("MIGRATE_DATABASE_URL")
  extensions = [citext, pgcrypto]
}

// ---- Enums -----------------------------------------------------------------

/// The lifecycle of a tenant. `deleting` exists so a purge can be started and
/// resumed — nothing actually deletes a workspace today, because every tenant
/// foreign key is ON DELETE RESTRICT.
enum WorkspaceStatus {
  active
  suspended
  deleting

  @@map("workspace_status")
}

enum UserRole {
  agent
  lead
  admin

  @@map("user_role")
}

enum TicketStatus {
  new
  open
  pending
  on_hold
  resolved
  closed

  @@map("ticket_status")
}

enum TicketPriority {
  low
  normal
  high
  urgent

  @@map("ticket_priority")
}

enum Channel {
  email
  api
  widget
  hashcare
  manual
  // one generic value for all third-party chatbots, never a partner-specific
  // one — otherwise this enum grows a member per customer forever
  chatbot

  @@map("channel")
}

enum AuthorType {
  customer
  agent
  system
  // a chatbot reply. Distinct from `system` (merge markers, automated notes)
  // and from `agent`, so reporting can separate bot work from human work
  bot

  @@map("author_type")
}

enum TicketOutcome {
  answered
  escalated
  out_of_scope

  @@map("ticket_outcome")
}

enum WebhookEvent {
  ticket_created   @map("ticket.created")
  ticket_updated   @map("ticket.updated")
  ticket_assigned  @map("ticket.assigned")
  ticket_resolved  @map("ticket.resolved")
  message_added    @map("message.added")
  sla_breached     @map("sla.breached")

  @@map("webhook_event")
}

// ---- Tables ----------------------------------------------------------------

/// A CUSTOMER'S EMPLOYER — the Zendesk/Intercom sense of the word. A child row
/// that lives inside a workspace and cannot exist without one. It is NOT a
/// tenant and never was; `Workspace` below is the tenant.
///
/// Called `Organization` until 2026-08-08. "Organization" is what Plumo PM
/// calls a tenant, and the collision cost a full investigation
/// (docs/organization-vs-workspace.md) before anyone was confident the CS
/// tenancy model was intact. Renaming the smaller thing was cheaper than
/// re-litigating that reading every time somebody new arrives.
model Company {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  name        String
  /// Email domain. Not cosmetic: findOrCreateByEmail() files a new customer
  /// under the company whose domain matches their address, so whoever can write
  /// this decides who sees whose tickets. That is why the write routes on
  /// CompaniesController are @Roles('admin').
  domain      String?
  externalRef String?    @map("external_ref")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz()
  customers   Customer[]
  tickets     Ticket[]

  @@map("companies")
}

model Customer {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  companyId      String?       @map("company_id") @db.Uuid
  company        Company?      @relation(fields: [companyId], references: [id])
  // Nullable since chatbot ingest: an anonymous visitor has no email. Uniqueness
  // is enforced by the partial index customers_email_unique_idx (WHERE email IS
  // NOT NULL), which Prisma cannot express — so there is no @unique here and
  // lookups use findFirst, not findUnique.
  email          String?       @db.Citext
  name           String
  phone          String?
  locale         String?
  timezone       String?
  externalRef    String?       @map("external_ref")
  // Identity for a visitor with no email: the chatbot that saw them plus that
  // chatbot's opaque reference. Unique per key via customers_visitor_unique_idx.
  visitorApiKeyId String?      @map("visitor_api_key_id") @db.Uuid
  visitorApiKey   ApiKey?      @relation("CustomerVisitorKey", fields: [visitorApiKeyId], references: [id])
  visitorRef      String?      @map("visitor_ref")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  tickets        Ticket[]

  @@index([companyId])
  // customers_email_unique_idx, customers_visitor_unique_idx and
  // customers_identity_check are partial/check constraints in the migration and
  // invisible here — `prisma migrate diff` will propose dropping them.
  @@map("customers")
}

model User {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String           @unique @db.Citext
  name            String
  passwordHash    String           @map("password_hash")
  avatarUrl       String?          @map("avatar_url")
  isActive        Boolean          @default(true) @map("is_active")
  /// Operates the platform, not a tenant. Deliberately NOT a workspace role:
  /// `role`, `teamId` and `availability` now live on WorkspaceMembership,
  /// because one human can be an admin of one desk and an agent on another.
  isPlatformAdmin Boolean          @default(false) @map("is_platform_admin")
  /// The `sub` from PM /userinfo — stable for the life of the PM account.
  /// Unique where present, so one PM identity can never resolve to two CS
  /// users: that ambiguity is an account-takeover shape, not untidy data.
  /// Nullable because CS accounts exist that have no PM account.
  pmUserId        String?          @unique @map("pm_user_id")
  lastActiveAt    DateTime?        @map("last_active_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  assignedTickets Ticket[]
  refreshTokens   RefreshToken[]
  apiKeys         ApiKey[]
  cannedResponses CannedResponse[]
  notifications   Notification[]
  passwordResets  PasswordReset[]
  memberships     WorkspaceMembership[]
  pmOAuthStates   PmOAuthState[]

  @@map("users")
}

model Team {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  name            String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  memberships     WorkspaceMembership[]
  tickets         Ticket[]
  cannedResponses CannedResponse[]
  apiKeys         ApiKey[]

  @@map("teams")
}

model BusinessHours {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  name         String
  timezone     String
  weeklyJson   Json        @map("weekly_json") // {mon:[["09:00","17:00"]], ...}
  holidaysJson Json        @default("[]") @map("holidays_json") // ["2026-12-25", ...]
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz()
  slaPolicies  SlaPolicy[]

  @@map("business_hours")
}

model SlaPolicy {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  name              String
  priority          TicketPriority
  firstResponseMins Int            @map("first_response_mins")
  resolutionMins    Int            @map("resolution_mins")
  businessHoursId   String?        @map("business_hours_id") @db.Uuid
  businessHours     BusinessHours? @relation(fields: [businessHoursId], references: [id])
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  tickets           Ticket[]

  @@map("sla_policies")
}

model Ticket {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  /// Assigned by tickets_number_trigger from this workspace's own sequence, NOT
  /// by Prisma. @default(0) keeps it optional on create and pairs with the
  /// CHECK (number > 0) so a missing trigger fails loudly on the first insert.
  number             BigInt          @default(0)
  subject            String
  status             TicketStatus    @default(new)
  priority           TicketPriority  @default(normal)
  channel            Channel
  customerId         String          @map("customer_id") @db.Uuid
  customer           Customer        @relation(fields: [customerId], references: [id])
  companyId          String?         @map("company_id") @db.Uuid
  company            Company?        @relation(fields: [companyId], references: [id])
  assigneeId         String?         @map("assignee_id") @db.Uuid
  assignee           User?           @relation(fields: [assigneeId], references: [id])
  teamId             String?         @map("team_id") @db.Uuid
  team               Team?           @relation(fields: [teamId], references: [id])
  slaPolicyId        String?         @map("sla_policy_id") @db.Uuid
  slaPolicy          SlaPolicy?      @relation(fields: [slaPolicyId], references: [id])
  firstResponseDueAt DateTime?       @map("first_response_due_at") @db.Timestamptz()
  resolutionDueAt    DateTime?       @map("resolution_due_at") @db.Timestamptz()
  firstRespondedAt   DateTime?       @map("first_responded_at") @db.Timestamptz()
  resolvedAt         DateTime?       @map("resolved_at") @db.Timestamptz()
  closedAt           DateTime?       @map("closed_at") @db.Timestamptz()
  slaPausedAt        DateTime?       @map("sla_paused_at") @db.Timestamptz()
  outcome            TicketOutcome?
  sourceRef          String?         @map("source_ref")
  // Which chatbot filed this. SET NULL on key deletion: revoking a chatbot must
  // never delete the conversations it handled.
  createdByApiKeyId  String?         @map("created_by_api_key_id") @db.Uuid
  createdByApiKey    ApiKey?         @relation("TicketCreatorKey", fields: [createdByApiKeyId], references: [id])
  // Bot-first SLA: a bot reply does NOT satisfy first response, it stamps its
  // own column. The human clock starts at handedOffAt.
  botRepliedAt       DateTime?       @map("bot_replied_at") @db.Timestamptz()
  /// May the chatbot still post here? False once a human takes over — by handing
  /// off, or simply by replying. The ingest API refuses bot messages while this
  /// is false, so a partner that ignores the flag still cannot talk over an agent.
  botEnabled         Boolean         @default(true) @map("bot_enabled")
  handedOffAt        DateTime?       @map("handed_off_at") @db.Timestamptz()
  tags               String[]        @default([])
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz()
  messages           TicketMessage[]
  notifications      Notification[]
  chatSessions       ChatSession[]
  // search_tsv tsvector column + its GIN index live in
  // prisma/migrations/20260801170000_search_tsv_and_btree_gin, maintained by the
  // tickets_tsv_trigger. Invisible to this schema, so `prisma migrate diff` will
  // propose DROPping them — never apply a generated diff.

  @@index([status])
  @@index([assigneeId])
  @@index([teamId])
  @@index([firstResponseDueAt])
  @@index([tags], type: Gin)
  // the default inbox ordering — matches the (updatedAt desc, id desc) sort
  // used by list(), including the cursor tiebreaker
  @@index([updatedAt(sort: Desc), id(sort: Desc)])
  @@map("tickets")
}

model TicketMessage {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  ticketId       String       @map("ticket_id") @db.Uuid
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType     AuthorType   @map("author_type")
  authorId       String?      @map("author_id") @db.Uuid // user or customer id
  body           String
  isInternalNote Boolean      @default(false) @map("is_internal_note")
  channel        Channel
  emailMessageId String?      @map("email_message_id")
  // Which chatbot wrote this, when authorType is `bot`.
  authorApiKeyId String?      @map("author_api_key_id") @db.Uuid
  authorApiKey   ApiKey?      @relation("MessageAuthorKey", fields: [authorApiKeyId], references: [id])
  // The partner's own id for this turn. Unique per ticket via
  // ticket_messages_external_ref_unique_idx, which is what makes appending a
  // message idempotent under retry.
  externalRef    String?      @map("external_ref")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  attachments    Attachment[]

  @@index([ticketId, createdAt])
  @@index([emailMessageId])
  @@map("ticket_messages")
}

model Attachment {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  // Nullable: rows are created "pending" at presign time and linked to a
  // message when the reply is posted (attachmentIds on POST …/messages).
  ticketMessageId String?        @map("ticket_message_id") @db.Uuid
  ticketMessage   TicketMessage? @relation(fields: [ticketMessageId], references: [id], onDelete: Cascade)
  filename        String
  contentType     String        @map("content_type")
  sizeBytes       Int           @map("size_bytes")
  storageKey      String        @map("storage_key")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  @@map("attachments")
}

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  key       String // slug used inside tickets.tags[]
  label     String
  color     String   @default("#94A3B8")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("tags")
}

model CannedResponse {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  title       String
  body        String
  tags        String[] @default([])
  teamId      String?  @map("team_id") @db.Uuid
  team        Team?    @relation(fields: [teamId], references: [id])
  createdById String   @map("created_by") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("canned_responses")
}

model ApiKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  name        String
  keyHash     String    @map("key_hash") // hash only; secret shown once
  keyPrefix   String    @map("key_prefix") // first chars, for lookup/display
  scopes      String[]  @default([])
  // Row-level confinement for a machine principal. When set, the key can only
  // see and touch tickets belonging to this team — the machine equivalent of a
  // lead's team scope. Null means instance-wide and must be granted deliberately
  // (see ApiKeysService.create). This is the seam multi-tenancy hangs off:
  // workspace_id joins the key right here.
  teamId      String?   @map("team_id") @db.Uuid
  team        Team?     @relation(fields: [teamId], references: [id])
  createdById String    @map("created_by") @db.Uuid
  createdBy   User      @relation(fields: [createdById], references: [id])
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz()
  isActive    Boolean   @default(true) @map("is_active")
  // Partner credentials are issued with an expiry; internal keys may be null.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // A chatbot IS an api key, so everything a chatbot produces points back here.
  ticketsCreated  Ticket[]        @relation("TicketCreatorKey")
  messagesWritten TicketMessage[] @relation("MessageAuthorKey")
  visitors        Customer[]      @relation("CustomerVisitorKey")
  chatSessions    ChatSession[]

  @@index([keyPrefix])
  @@index([teamId])
  @@map("api_keys")
}

// Watermark for the nightly partner export.
//
// This used to live in audit_log as a synthetic row with a sentinel entity id,
// which conflated an operational cursor with an append-only compliance record —
// and would have been lost the moment audit_log is partitioned for retention.
model ExportState {
  id         String   @default("daily")
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  watermark  DateTime @db.Timestamptz()
  lastCount  Int      @default(0) @map("last_count")
  lastRunAt  DateTime @default(now()) @map("last_run_at") @db.Timestamptz()
  watermarkId String? @map("watermark_id") @db.Uuid

  @@id([workspaceId, id])
  @@map("export_state")
}

model Webhook {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  url        String
  events     WebhookEvent[]
  secret     String
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz()
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  webhookId   String       @map("webhook_id") @db.Uuid
  webhook     Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event       WebhookEvent
  payloadJson Json         @map("payload_json")
  status      String       @default("pending") // pending|delivered|failed
  attempts    Int          @default(0)
  lastError   String?      @map("last_error")
  deliveredAt DateTime?    @map("delivered_at") @db.Timestamptz()
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  @@map("webhook_deliveries")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId])
  @@map("password_resets")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // assignment | mention | sla_warning | sla_breach
  text      String
  ticketId  String?   @map("ticket_id") @db.Uuid
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  readAt    DateTime? @map("read_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  actorType  String   @map("actor_type") // user | api_key | system
  actorId    String?  @map("actor_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  diffJson   Json?    @map("diff_json")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}

/// One chatbot conversation, mapped to exactly one ticket.
///
/// The partner sends its own opaque session reference; the unique index on
/// (apiKeyId, sessionRef) is what makes opening a conversation idempotent
/// without a separate idempotency-key ledger. It is keyed on the API key rather
/// than the workspace because a key belongs to exactly one workspace, so the
/// per-key constraint is strictly narrower and stays correct after tenancy
/// lands — it never needs widening or a data migration.
model ChatSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  apiKeyId   String   @map("api_key_id") @db.Uuid
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  sessionRef String   @map("session_ref")
  ticketId   String   @map("ticket_id") @db.Uuid
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  visitorRef String?  @map("visitor_ref")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([apiKeyId, sessionRef])
  @@index([ticketId])
  @@map("chat_sessions")
}


/// A tenant: one support desk. Distinct from `Company`, which is a CUSTOMER's
/// employer. Both concepts are real and they are not the same thing — which is
/// exactly why `Company` stopped being called `Organization`.
model Workspace {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String          @unique @db.Citext
  name         String
  status       WorkspaceStatus @default(active)
  /// Set when this desk was imported from a Plumo PM workspace (Phase 4).
  /// The PM workspace this desk was linked to (Phase 4). TEXT, not uuid: PM is
  /// MongoDB and its ids are ObjectIds — 24 hex characters, which a uuid column
  /// rejects outright. Opaque to CS; never parsed.
  pmWorkspaceId String?        @map("pm_workspace_id")
  /// Affordance for per-workspace inbound mail. The email channel is NOT
  /// multi-tenant yet: threading by "[Plumo #N]" or In-Reply-To is ambiguous
  /// across tenants until the receiving address resolves the workspace.
  inboundEmail String?         @map("inbound_email") @db.Citext
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz()
  memberships  WorkspaceMembership[]

  @@map("workspaces")
}

/// Resolves the collision between global identity and tenant-owned teams: one
/// human, many desks, a different role and team on each.
model WorkspaceMembership {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         UserRole  @default(agent)
  teamId       String?   @map("team_id") @db.Uuid
  team         Team?     @relation(fields: [teamId], references: [id])
  isActive     Boolean   @default(true) @map("is_active")
  availability String    @default("available")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_memberships")
}

/// A pending seat on a desk.
///
/// Tenant-scoped, unlike PasswordReset, which it otherwise resembles: a reset is
/// about a PERSON and a person is global, while an invitation is about a SEAT and
/// a seat belongs to exactly one workspace. So this table carries workspace_id
/// and the workspace_isolation policy — which is why the unauthenticated accept
/// flow reads it through app_resolve_invitation() (SECURITY DEFINER) rather than
/// through this model: an unbound findFirst matches zero rows and would report
/// every live invitation link as invalid.
///
/// NO RELATION FIELDS, on purpose. Every reference here is a COMPOSITE foreign
/// key in the database — (workspace_id, team_id) and (workspace_id, invited_by),
/// the latter targeting workspace_memberships so an inviter is structurally a
/// member of the desk they are inviting into. Prisma cannot express either, and
/// declaring the single-column versions would have `prisma migrate diff` propose
/// replacing the real constraints with weaker ones.
///
/// Also invisible here: invitations_pending_email_key, the partial unique index
/// on (workspace_id, email) WHERE accepted_at IS NULL AND revoked_at IS NULL,
/// which is what makes re-inviting an address REPLACE its pending invitation
/// rather than issue a second live token. Same situation as
/// customers_email_unique_idx — never apply a generated diff.
model Invitation {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @default(dbgenerated("app_current_workspace()")) @map("workspace_id") @db.Uuid
  email        String    @db.Citext
  role         UserRole  @default(agent)
  teamId       String?   @map("team_id") @db.Uuid
  /// sha256 of the 32 random bytes emailed to the invitee, hex. The plaintext is
  /// never stored — same rule as PasswordReset.tokenHash and ApiKey.keyHash.
  tokenHash    String    @unique @map("token_hash")
  invitedById  String    @map("invited_by") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz()
  /// Single use. Claimed atomically with `updateMany({ where: { acceptedAt: null } })`
  /// so two simultaneous clicks resolve to one membership and one refusal.
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz()
  acceptedById String?   @map("accepted_by") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz()
  revokedById  String?   @map("revoked_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("invitations")
}

/// Append-only record of authentication events.
///
/// MUST NOT be written with `prisma.identityAuditLog.create()`. Prisma's
/// `create()` always emits INSERT ... RETURNING, and RETURNING needs SELECT
/// privilege — which plumo_app deliberately does not have on this table, so the
/// trail cannot be read back or tampered with by the runtime. Use $executeRaw.
model IdentityAuditLog {
  id         BigInt   @id @default(autoincrement())
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  diffJson   Json?    @map("diff_json")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("identity_audit_log")
}

/// This CS deployment's OAuth client registration with a Plumo PM issuer.
///
/// Global, not per-workspace: it identifies this deployment to PM, not any one
/// desk. Consulted before a workspace is known, so like `users` it carries no
/// workspace_id and no RLS policy.
model PmOAuthClient {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issuer      String
  redirectUri String   @map("redirect_uri")
  clientId    String   @map("client_id")
  scopes      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([issuer, redirectUri])
  @@map("pm_oauth_clients")
}

/// An in-flight PKCE authorization.
///
/// The code_verifier is kept server-side deliberately — putting it in a cookie
/// would hand the browser the one secret PKCE exists to keep out of it.
///
/// NOT TENANT DATA, and deliberately carries no `workspace_id` to say so. A row
/// here belongs to a handshake, not to a desk: it is created before anybody is
/// signed in and read back by a @Public() callback on a connection with no
/// workspace bound. `workspace_id = app_current_workspace()` would be NULL
/// rather than true for every one of those reads, so the standard policy would
/// refuse every PM sign-in rather than isolate anything. What protects a row is
/// the unguessable single-use `state`, the ten-minute expiry, and `consumedAt`.
model PmOAuthState {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state             String    @unique
  codeVerifier      String    @map("code_verifier")
  /// Who began the flow. The link is applied to THIS user, so a stolen callback
  /// cannot attach a PM identity to an account the caller does not control.
  /// Set for a link (apply to this user); NULL for a sign-in (resolve the user
  /// from the PM subject). The null is the distinction between the two flows.
  userId            String?   @map("user_id") @db.Uuid
  user              User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The desk to map to a PM workspace if this flow comes back as a LINK — a
  /// hint carried across the round trip, not the tenant that owns the row.
  /// NULL for a sign-in, which starts at the login screen with no desk known.
  linkWorkspaceId   String?   @map("link_workspace_id") @db.Uuid
  returnTo          String?   @map("return_to")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz()
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([expiresAt])
  @@map("pm_oauth_states")
}
