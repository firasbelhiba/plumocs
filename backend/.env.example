# App
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# Database
# Runtime connection: plumo_app — owns nothing, cannot bypass RLS.
# Never point this at a superuser or the schema owner; the API asserts this at
# boot and refuses to start, because a privileged runtime silently disables
# every row-level security policy. Provision with prisma/sql/roles.sql.
DATABASE_URL=postgresql://plumo_app:CHANGEME_app@localhost:5432/plumo_cs?schema=public
# Migration connection: plumo_migrator — the schema owner. Used by Prisma
# Migrate via datasource.directUrl, never by the running application.
MIGRATE_DATABASE_URL=postgresql://plumo_migrator:CHANGEME_migrator@localhost:5432/plumo_cs?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=plumo-attachments
S3_ACCESS_KEY=plumo
S3_SECRET_KEY=plumo-secret
S3_REGION=us-east-1

# Email — outbound SMTP (MailHog locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="plumo support <help@plumo.app>"

# Email — inbound (webhook mode). Secret the provider must send.
INBOUND_EMAIL_WEBHOOK_SECRET=change-me-inbound

# Sign in with Plumo (PM). All optional — unset, the console hides the button
# and everything else works.
PM_ISSUER=
# Must be registered with PM and must point at THIS api, not the console. The
# sign-in hop is derived from it by swapping the last path segment, so the two
# share an origin and a directory and the binding cookie set by one is sent to
# the other. Pointing this somewhere structurally different breaks sign-in.
PM_REDIRECT_URI=http://localhost:3001/api/v1/auth/pm/callback
# THE CONSOLE'S ORIGIN, never this api — despite the PM_ prefix this is not
# only used by PM. The password-reset email links here too, so leaving it unset
# on a real deployment sends every reset link to http://localhost:3000. It used
# to fall back to APP_URL, which in production is the api and served no pages.
PM_CONSOLE_URL=http://localhost:3000

# Webhooks
WEBHOOK_SIGNING_DEFAULT_SECRET=change-me-webhooks

# Rate limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=120
# Which upstream hops may state a client's address. Anonymous callers are rate
# limited on the address this resolves, so it decides whether the limits hold.
# Leave UNSET for both real deployments: nginx is native on the same host and
# the containers use network_mode: host, so the proxy is loopback and loopback
# is the default. Only set it if a proxy ever runs somewhere else — and then set
# it to that proxy, because naming the wrong network buckets every anonymous
# caller together and the console starts 429ing agents for traffic that is not
# theirs. Comma-separated IPs/CIDRs, or loopback / linklocal / uniquelocal.
# TRUSTED_PROXY_IPS=

# Logging
LOG_LEVEL=info
